  "lastName": "Agent",
  "email": "bob.agent@travelco.com",
  "phoneNumber": "+12125550300"
}

###

### Send flight alert manually
POST {{baseUrl}}/admin/notifications/flight-alert
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "flightId": "PASTE_FLIGHT_ID_HERE",
  "isCancellation": false
}


# ─────────────────────────────────────────────────────────────
# 12. RATE LIMITING TEST
# ─────────────────────────────────────────────────────────────

### Hit auth endpoint 6 times to trigger rate limit (5 per 15 min)
### Expected: 6th request returns 429 Too Many Requests

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "wrong@example.com",
  "password": "wrongpassword"
}


# ─────────────────────────────────────────────────────────────
# NOTES FOR TESTING
# ─────────────────────────────────────────────────────────────
#
# 1. BOOKING EXPIRY TEST:
#    - Create a booking (gets 15-min hold)
#    - Wait 15+ minutes (or set BookingHoldMinutes=1 in appsettings)
#    - BookingExpiryService runs every 60s
#    - Booking status becomes "Expired"
#
# 2. STRIPE TESTING:
#    - Use Stripe test card: 4242 4242 4242 4242
#    - Expiry: any future date, CVC: any 3 digits
#    - Use Stripe CLI to test webhooks: stripe listen --forward-to localhost:7001/api/v1/payments/webhook
#
# 3. EMAIL TESTING:
#    - Configure Gmail app password in appsettings.Development.json
#    - Or use Mailhog/Mailtrap for local testing
#
# 4. ENCRYPTION:
#    - Set AIRSYSTEM_MASTER_KEY environment variable before running
#    - Local dev uses default key (change for production)
#
# 5. FULL BOOKING FLOW:
#    POST /search/one-way → find flightId
#    POST /bookings → get bookingId + reference (15-min hold starts)
#    POST /payments/promo/validate (optional)
#    POST /payments/intent → get clientSecret
#    [Use Stripe.js frontend with clientSecret]
#    POST /payments/confirm → booking confirmed, tickets generated
#    GET  /tickets/booking/{bookingId} → get ticket numbers
#    GET  /tickets/{number}/download → PDF e-ticket
#    GET  /tickets/{number}/boarding-pass → QR boarding pass PDF

